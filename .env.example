# Tunisia PC Advisor — local environment template
#
# Copy this file to .env in the project root and edit the values for your
# machine. Never commit the real .env file.
#
# The application reads this file through bootstrap.php. Real process
# environment variables take precedence over values defined here. Values may
# be wrapped in single or double quotes; inline comments after a value are not
# supported, so keep comments on their own lines.
#
# The database defaults below are also the application's built-in fallbacks, so
# a missing .env still works for a standard local XAMPP installation. Set the
# values explicitly when your MySQL account or URL differs.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Local environment label. Use "production" only for a real deployment.
APP_ENV=local

# Set to true only while debugging locally. Keep false for anything shared.
APP_DEBUG=false

# Public base URL, without a trailing slash. Leave empty to auto-detect it from
# the request (recommended for XAMPP subfolder installs). Set it explicitly if
# the detected URL is wrong, for example behind a proxy or on a custom host.
APP_URL=

# ---------------------------------------------------------------------------
# MySQL / MariaDB
# ---------------------------------------------------------------------------
# Defaults match a standard XAMPP installation. Change DB_USER and DB_PASS if
# your MySQL account is not root with an empty password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tunisia_pc_advisor
DB_USER=root
DB_PASS=
